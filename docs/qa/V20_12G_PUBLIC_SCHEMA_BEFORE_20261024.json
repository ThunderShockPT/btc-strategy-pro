      "name": "btcsp_delete_project_v1",
      "owner": "postgres",
      "identity": "btcsp_delete_project_v1(uuid,timestamp with time zone,integer)",
      "definition": "CREATE OR REPLACE FUNCTION public.btcsp_delete_project_v1(p_id uuid, p_expected_meta_updated_at timestamp with time zone, p_expected_version integer)\n RETURNS boolean\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nDECLARE\n v_uid uuid;\n v_existing record;\n v_snapshot record;\n v_current_version integer;\nBEGIN\n v_uid:=auth.uid();\n IF v_uid IS NULL THEN\n   RAISE EXCEPTION 'BTCSP_NOT_AUTHENTICATED' USING ERRCODE='28000';\n END IF;\n IF p_id IS NULL OR p_expected_meta_updated_at IS NULL THEN\n   RAISE EXCEPTION 'BTCSP_INVALID_DATA' USING ERRCODE='22023';\n END IF;\n SELECT * INTO v_existing FROM public.projects\n   WHERE id=p_id AND owner_id=v_uid FOR UPDATE;\n IF NOT FOUND OR v_existing.updated_at IS DISTINCT FROM p_expected_meta_updated_at THEN\n   RAISE EXCEPTION 'BTCSP_VERSION_CONFLICT' USING ERRCODE='P0001';\n END IF;\n SELECT * INTO v_snapshot FROM public.project_snapshots\n   WHERE project_id=p_id AND owner_id=v_uid FOR UPDATE;\n IF FOUND THEN v_current_version:=v_snapshot.version;\n ELSE v_current_version:=NULL; END IF;\n IF v_current_version IS DISTINCT FROM p_expected_version THEN\n   RAISE EXCEPTION 'BTCSP_VERSION_CONFLICT' USING ERRCODE='P0001';\n END IF;\n DELETE FROM public.projects WHERE id=p_id AND owner_id=v_uid;\n RETURN true;\nEND\n$function$\n"
    },
    {
      "acl": [
        "postgres=X/postgres",
        "authenticated=X/postgres",
        "service_role=X/postgres"
      ],
      "name": "btcsp_save_project_v1",
      "owner": "postgres",
      "identity": "btcsp_save_project_v1(uuid,text,text,numeric,boolean,jsonb,timestamp with time zone,integer)",
      "definition": "CREATE OR REPLACE FUNCTION public.btcsp_save_project_v1(p_id uuid, p_name text, p_mode text, p_capital numeric, p_archived boolean, p_payload jsonb, p_expected_meta_updated_at timestamp with time zone DEFAULT NULL::timestamp with time zone, p_expected_version integer DEFAULT NULL::integer)\n RETURNS TABLE(meta_updated_at timestamp with time zone, snapshot_version integer)\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nDECLARE\n  v_uid uuid;\n  v_existing record;\n  v_snapshot record;\n  v_meta timestamptz;\n  v_version integer;\nBEGIN\n  v_uid := auth.uid();\n  IF v_uid IS NULL THEN\n    RAISE EXCEPTION 'BTCSP_NOT_AUTHENTICATED' USING ERRCODE='28000';\n  END IF;\n  IF p_id IS NULL OR p_name IS NULL OR char_length(btrim(p_name)) NOT BETWEEN 2 AND 65\n     OR p_mode NOT IN ('demo','real') OR p_mode IS NULL\n     OR p_capital IS NULL OR p_capital NOT BETWEEN 100 AND 1000000000\n     OR p_archived IS NULL OR p_payload IS NULL OR jsonb_typeof(p_payload) <> 'object'\n     OR octet_length(p_payload::text)>1500000 THEN\n     RAISE EXCEPTION 'BTCSP_INVALID_DATA' USING ERRCODE='22023';\n  END IF;\n\n  -- Lock project row: serialize same-project writes across clients, then check\n  -- both expected metadata timestamp and expected snapshot revision.\n  SELECT * INTO v_existing FROM public.projects\n    WHERE id=p_id AND owner_id=v_uid FOR UPDATE;\n  IF FOUND THEN\n    IF v_existing.updated_at IS DISTINCT FROM p_expected_meta_updated_at THEN\n      RAISE EXCEPTION 'BTCSP_VERSION_CONFLICT' USING ERRCODE='P0001';\n    END IF;\n    SELECT * INTO v_snapshot FROM public.project_snapshots\n      WHERE project_id=p_id AND owner_id=v_uid FOR UPDATE;\n    IF FOUND THEN\n      IF v_snapshot.version IS DISTINCT FROM p_expected_version THEN\n        RAISE EXCEPTION 'BTCSP_VERSION_CONFLICT' USING ERRCODE='P0001';\n      END IF;\n      IF v_snapshot.payload IS DISTINCT FROM p_payload THEN\n        UPDATE public.project_snapshots\n          SET payload=p_payload, version=v_snapshot.version+1\n          WHERE project_id=p_id AND owner_id=v_uid RETURNING version INTO v_version;\n      ELSE\n        v_version := v_snapshot.version;\n      END IF;\n    ELSE\n      IF p_expected_version IS NOT NULL THEN\n        RAISE EXCEPTION 'BTCSP_VERSION_CONFLICT' USING ERRCODE='P0001';\n      END IF;\n      INSERT INTO public.project_snapshots(project_id,owner_id,payload,version)\n        VALUES(p_id,v_uid,p_payload,1) RETURNING version INTO v_version;\n    END IF;\n    IF v_existing.name IS DISTINCT FROM p_name\n      OR v_existing.mode IS DISTINCT FROM p_mode\n      OR v_existing.capital IS DISTINCT FROM p_capital\n      OR v_existing.archived IS DISTINCT FROM p_archived THEN\n      UPDATE public.projects\n        SET name=btrim(p_name),mode=p_mode,capital=p_capital,archived=p_archived\n        WHERE id=p_id AND owner_id=v_uid\n        RETURNING updated_at INTO v_meta;\n    ELSE\n      v_meta := v_existing.updated_at;\n    END IF;\n  ELSE\n    -- A new project must not overwrite an existing or deleted one.\n    IF p_expected_meta_updated_at IS NOT NULL OR p_expected_version IS NOT NULL THEN\n      RAISE EXCEPTION 'BTCSP_VERSION_CONFLICT' USING ERRCODE='P0001';\n    END IF;\n    INSERT INTO public.projects(id,owner_id,name,mode,capital,archived)\n      VALUES(p_id,v_uid,btrim(p_name),p_mode,p_capital,p_archived)\n      RETURNING updated_at INTO v_meta;\n    INSERT INTO public.project_snapshots(project_id,owner_id,payload,version)\n      VALUES(p_id,v_uid,p_payload,1) RETURNING version INTO v_version;\n  END IF;\n  RETURN QUERY SELECT v_meta,v_version;\nEND\n$function$\n"
    },
